{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybook",
  "version": "1.0.0",
  "identifier": "com.daybook.planner",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Daybook",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Your schedule, classes, work and projects in one planner.",
    "copyright": "",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
